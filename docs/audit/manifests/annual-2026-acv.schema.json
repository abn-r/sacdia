{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sacdia.app/schemas/annual-2026-acv.schema.json",
  "title": "Configuración anual ACV 2026",
  "description": "Contrato funcional firmado para ranking y plantillas anuales de ACV. El implementador no puede inferir los valores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "master_guides_ranking",
    "templates",
    "conquerors_existing_template",
    "content_sha256",
    "approvals"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecclesiastical_year_id", "year", "owner_scope", "owner_id"],
      "properties": {
        "ecclesiastical_year_id": { "const": 1 },
        "year": { "const": 2026 },
        "owner_scope": { "const": "local_field" },
        "owner_id": { "const": 4 }
      }
    },
    "master_guides_ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["club_type_id", "max_points", "axes", "components"],
      "properties": {
        "club_type_id": { "const": 3 },
        "max_points": { "$ref": "#/$defs/positiveInteger" },
        "axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scoredItem" }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scoredItem" }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adventurers", "master_guides"],
      "properties": {
        "adventurers": {
          "allOf": [
            { "$ref": "#/$defs/template" },
            { "properties": { "club_type_id": { "const": 1 } } }
          ]
        },
        "master_guides": {
          "allOf": [
            { "$ref": "#/$defs/template" },
            { "properties": { "club_type_id": { "const": 3 } } }
          ]
        }
      }
    },
    "conquerors_existing_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["club_type_id", "folder_template_id", "closing_date"],
      "properties": {
        "club_type_id": { "const": 2 },
        "folder_template_id": { "$ref": "#/$defs/uuid" },
        "closing_date": { "$ref": "#/$defs/date2026" }
      }
    },
    "content_sha256": {
      "description": "SHA-256 del JSON canónico excluyendo content_sha256 y approvals.",
      "$ref": "#/$defs/sha256"
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking", "templates"],
      "properties": {
        "ranking": {
          "allOf": [
            { "$ref": "#/$defs/approval" },
            {
              "properties": {
                "approver_role": {
                  "enum": ["director-union", "assistant-union", "admin", "super-admin"]
                }
              }
            }
          ]
        },
        "templates": {
          "allOf": [
            { "$ref": "#/$defs/approval" },
            {
              "properties": {
                "approver_role": {
                  "enum": ["director-lf", "assistant-lf", "admin", "super-admin"]
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date2026": {
      "type": "string",
      "format": "date",
      "pattern": "^2026-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$"
    },
    "scoredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "max_points", "display_order", "active"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "max_points": { "$ref": "#/$defs/positiveInteger" },
        "display_order": { "type": "integer", "minimum": 1 },
        "active": { "const": true }
      }
    },
    "templateSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "max_points", "display_order", "required"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "max_points": { "$ref": "#/$defs/positiveInteger" },
        "display_order": { "type": "integer", "minimum": 1 },
        "required": { "type": "boolean" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "club_type_id",
        "name",
        "minimum_points",
        "closing_date",
        "sections"
      ],
      "properties": {
        "club_type_id": { "enum": [1, 3] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "minimum_points": { "$ref": "#/$defs/positiveInteger" },
        "closing_date": { "$ref": "#/$defs/date2026" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/templateSection" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by_user_id",
        "approved_by_name",
        "approver_role",
        "approved_at",
        "content_sha256"
      ],
      "properties": {
        "approved_by_user_id": { "$ref": "#/$defs/uuid" },
        "approved_by_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "approver_role": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
